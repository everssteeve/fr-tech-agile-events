---
import '../styles/global.css';
import { href } from '../lib/data';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Synthèses des retours participants des événements tech et agiles français.' } = Astro.props;
const nav = [
  { path: '', label: 'Calendrier' },
  { path: 'mois/', label: 'Synthèses du mois' },
  { path: 'evenements/', label: 'Événements' },
  { path: 'methode/', label: 'Méthode' },
];
const current = Astro.url.pathname;
const isActive = (path: string) => {
  const target = href(path);
  if (path === '') return current === target || current === `${target}/` || current.startsWith(href('annee/'));
  return current.startsWith(target);
};
const onSearch = current.startsWith(href('recherche/'));
const onFavs = current.startsWith(href('favoris/'));
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      // Apply the reader's theme choice before first paint (no flash). "auto" follows the system.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="site" id="site-header">
      <div class="wrap bar">
        <a class="brand" href={href('')}>Retours de conf'<span>tech &amp; agile · France</span></a>
        <div class="actions">
          <a class={`search${onSearch ? ' on' : ''}`} href={href('recherche/')} aria-current={onSearch ? 'page' : undefined} title="Rechercher (touche /)">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <span class="search-label">Rechercher</span>
          </a>
          <a class={`search favs${onFavs ? ' on' : ''}`} href={href('favoris/')} aria-current={onFavs ? 'page' : undefined} title="Mes favoris et lectures">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 2.6l2.3 4.7 5.2.8-3.8 3.6.9 5.2L10 14.4l-4.6 2.5.9-5.2-3.8-3.6 5.2-.8z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            <span class="sr-only">Mes favoris</span><span class="fav-n" id="fav-n" hidden></span>
          </a>
          <button type="button" class="search theme-btn" id="theme-btn" data-mode="auto">
            <svg class="i-auto" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M10 3.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"/></svg>
            <svg class="i-light" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="3.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M10 1.8v2.4M10 15.8v2.4M1.8 10h2.4M15.8 10h2.4M4.2 4.2l1.7 1.7M14.1 14.1l1.7 1.7M4.2 15.8l1.7-1.7M14.1 5.9l1.7-1.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <svg class="i-dark" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M16.5 12.3A7 7 0 0 1 7.7 3.5a7 7 0 1 0 8.8 8.8z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            <span class="sr-only" id="theme-label">Thème : automatique</span>
          </button>
          <button type="button" class="menu-btn" aria-expanded="false" aria-controls="main-nav">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <span class="menu-label">Menu</span>
          </button>
        </div>
        <nav id="main-nav" aria-label="Navigation principale">
          {nav.map((n) => <a href={href(n.path)} aria-current={isActive(n.path) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap foot">
        <p>Synthèses produites à partir de retours publics (LinkedIn, blogs, vidéos), mises à jour chaque nuit. <a href={href('methode/')}>Comment c'est fait</a></p>
        <p><a href="https://github.com/everssteeve/fr-tech-agile-events">Code source</a></p>
      </div>
    </footer>
    <button type="button" class="to-top" id="to-top" hidden aria-label="Revenir en haut de la page">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 16V4M4.5 9.5L10 4l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>Haut</span>
    </button>
    <script>
      import { marks, subscribe } from '../lib/library';

      const header = document.getElementById('site-header')!;
      const root = document.documentElement;
      // Expose the header height so sticky bars and scroll margins stack under it.
      new ResizeObserver(() => root.style.setProperty('--hdr-h', `${header.offsetHeight}px`)).observe(header);

      const btn = header.querySelector<HTMLButtonElement>('.menu-btn')!;
      const nav = document.getElementById('main-nav')!;
      const setOpen = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        nav.classList.toggle('open', open);
      };
      btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setOpen(false);
        const t = e.target as HTMLElement;
        const typing = t.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName);
        if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey) {
          const search = document.querySelector<HTMLInputElement>('#q');
          e.preventDefault();
          if (search) search.focus();
          else location.href = header.querySelector<HTMLAnchorElement>('.search')!.href;
        }
      });

      // Theme: three states cycled by one button (automatic → light → dark). The choice is kept per browser.
      const themeBtn = document.getElementById('theme-btn')!;
      const themeLabel = document.getElementById('theme-label')!;
      const MODES = ['auto', 'light', 'dark'] as const;
      const NAMES = { auto: 'automatique', light: 'clair', dark: 'sombre' };
      type Mode = (typeof MODES)[number];
      const showTheme = (m: Mode) => {
        themeBtn.dataset.mode = m;
        themeLabel.textContent = `Thème : ${NAMES[m]}`;
        themeBtn.title = `Thème ${NAMES[m]} (changer)`;
      };
      const current = root.dataset.theme;
      showTheme(current === 'light' || current === 'dark' ? current : 'auto');
      themeBtn.addEventListener('click', () => {
        const next = MODES[(MODES.indexOf(themeBtn.dataset.mode as Mode) + 1) % MODES.length];
        if (next === 'auto') delete root.dataset.theme;
        else root.dataset.theme = next;
        try {
          if (next === 'auto') localStorage.removeItem('theme');
          else localStorage.setItem('theme', next);
        } catch {}
        showTheme(next);
      });

      // Bookmark count in the header.
      const favN = document.getElementById('fav-n')!;
      subscribe(() => {
        const n = marks().length;
        favN.hidden = n === 0;
        favN.textContent = String(n);
      });

      // Back to top: shown once the reader is more than a screen away from the top.
      const toTop = document.getElementById('to-top')!;
      const onScroll = () => { toTop.hidden = scrollY < innerHeight * 1.2; };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      toTop.addEventListener('click', () => {
        scrollTo({ top: 0, behavior: 'instant' });
        header.querySelector<HTMLAnchorElement>('.brand')!.focus();
      });
    </script>
  </body>
</html>
<style>
  .skip { position: absolute; left: var(--space-3); top: -60px; z-index: var(--z-top); background: var(--ink); color: var(--bg); padding: var(--space-2-5) var(--space-3-5); border-radius: var(--radius-sm); text-decoration: none; }
  .skip:focus { top: var(--space-2); }
  header.site { border-bottom: 1px solid var(--line); background: var(--surface); position: sticky; top: 0; z-index: var(--z-header); }
  .bar { display: flex; align-items: center; gap: var(--space-2) var(--space-6); padding-block: var(--space-2); }
  .brand { font-family: var(--font-d); font-weight: 800; font-size: var(--text-heading); white-space: nowrap; text-decoration: none; display: flex; align-items: baseline; gap: var(--space-2-5); margin-right: auto; padding-block: var(--space-1-5); }
  .brand span { font-family: var(--font-m); font-weight: 400; font-size: var(--text-mono); color: var(--muted); letter-spacing: .06em; text-transform: uppercase; }
  nav { display: flex; gap: var(--space-1); order: 2; }
  nav a { text-decoration: none; color: var(--muted); font-size: var(--text-ui); padding: var(--space-2-5); border-radius: var(--radius-sm); position: relative; white-space: nowrap; }
  nav a:hover { color: var(--ink); background: var(--surface-2); }
  nav a[aria-current="page"] { color: var(--ink); }
  nav a[aria-current="page"]::after { content: ""; position: absolute; left: var(--space-2-5); right: var(--space-2-5); bottom: var(--space-1); height: 2px; background: var(--accent); }
  .actions { display: flex; align-items: center; gap: var(--space-1-5); order: 3; }
  .search, .menu-btn { display: inline-flex; align-items: center; gap: var(--space-1-5); min-height: var(--space-10); padding: 0 var(--space-3); border: 1px solid var(--line-strong); border-radius: var(--radius-pill); background: var(--surface); color: var(--muted); font: inherit; font-size: var(--text-small); text-decoration: none; cursor: pointer; }
  .search:hover, .menu-btn:hover, .search.on { color: var(--ink); border-color: var(--muted); }
  .menu-btn { display: none; }
  .favs, .theme-btn { padding: 0 var(--space-2-5); }
  .theme-btn svg { display: none; }
  .theme-btn[data-mode="auto"] .i-auto, .theme-btn[data-mode="light"] .i-light, .theme-btn[data-mode="dark"] .i-dark { display: block; }
  .fav-n { font-family: var(--font-m); font-size: var(--text-mono); min-width: 18px; height: 18px; padding: 0 5px; border-radius: var(--radius-pill); background: var(--accent); color: var(--on-accent); display: inline-grid; place-items: center; }
  @media (max-width: 1180px) { .brand span { display: none; } }
  @media (max-width: 900px) {
    .menu-btn { display: inline-flex; }
    .search-label { display: none; }
    .search { padding: 0; width: var(--target-touch); justify-content: center; }
    .bar { column-gap: var(--space-3); }
    .favs { position: relative; }
    .favs .fav-n { position: absolute; top: calc(-1 * var(--space-1)); right: calc(-1 * var(--space-1)); }
    .search, .menu-btn { min-height: var(--target-touch); }
    .bar { flex-wrap: wrap; }
    nav { display: none; order: 4; flex-basis: 100%; flex-direction: column; gap: 0; padding-bottom: var(--space-2); }
    nav.open { display: flex; }
    nav a { padding: var(--space-3) var(--space-2); font-size: var(--text-body); }
    nav a[aria-current="page"]::after { left: var(--space-2); right: auto; width: var(--space-6); bottom: var(--space-1-5); }
  }
  @media (max-width: 420px) {
    .brand { font-size: var(--text-lede); }
    .bar { column-gap: var(--space-2); }
    .actions { gap: var(--space-1); }
    .menu-btn { padding: 0; width: var(--target-touch); justify-content: center; }
    .menu-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  main { padding-block: var(--space-8) var(--space-16); }
  main:focus { outline: none; }
  footer.site { border-top: 1px solid var(--line); padding-block: var(--space-5) var(--space-8); font-size: var(--text-fine); color: var(--muted); }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-6); }
  .foot p { margin: 0; }
  .to-top { position: fixed; right: var(--space-4); bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px)); z-index: var(--z-fab); display: inline-flex; align-items: center; gap: var(--space-1-5); min-height: var(--target-touch); padding: 0 var(--space-4); border-radius: var(--radius-pill); border: 1px solid var(--ink); background: var(--ink); color: var(--bg); font: inherit; font-size: var(--text-small); cursor: pointer; }
  .to-top:hover { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
</style>
