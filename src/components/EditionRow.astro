---
import { CATEGORIES, CONFIDENCE, editionPath, type Edition, type Category, when } from '../lib/data';

interface Props {
  edition: Edition;
  name: string;
  category: Category;
  /** Show the month in the date column (lists not grouped by month). */
  showMonth?: boolean;
  /** Hide the category tag (lists of a single event). */
  hideCategory?: boolean;
  headingLevel?: 'h3' | 'h4';
}
const { edition: e, name, category, showMonth = false, hideCategory = false, headingLevel = 'h3' } = Astro.props;
const st = when(e);
const WD = ['dim', 'lun', 'mar', 'mer', 'jeu', 'ven', 'sam'];
const MS = ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'];
const d = (s: string) => new Date(`${s}T12:00:00Z`);
let big = '—';
let small = 'date à préciser';
if (e.start.length === 10) {
  const a = d(e.start);
  const b = d(e.end ?? e.start);
  const multi = !!e.end && e.end !== e.start;
  const same = a.getUTCMonth() === b.getUTCMonth();
  if (!multi) big = showMonth ? `${a.getUTCDate()} ${MS[a.getUTCMonth()]}` : String(a.getUTCDate());
  else if (same) big = showMonth ? `${a.getUTCDate()}–${b.getUTCDate()} ${MS[b.getUTCMonth()]}` : `${a.getUTCDate()}–${b.getUTCDate()}`;
  else big = `${a.getUTCDate()} ${MS[a.getUTCMonth()]} – ${b.getUTCDate()} ${MS[b.getUTCMonth()]}`;
  small = multi ? `${WD[a.getUTCDay()]}. → ${WD[b.getUTCDay()]}.` : `${WD[a.getUTCDay()]}.`;
} else if (e.start.length === 7) {
  big = MS[Number(e.start.slice(5, 7)) - 1] ?? '—';
}
const videos = e.sessions.filter((s) => s.video).length;
const conf = CONFIDENCE[e.dateConfidence];
const synth = e.status === 'synthesized';
const H = headingLevel;
const plain = (t: string) => t.replace(/\*\*(.+?)\*\*/g, '$1').replace(/\*(.+?)\*/g, '$1');
---
<article class={`row ${st}${synth ? ' synth' : ''}`} data-cat={category} data-synth={synth ? '1' : '0'} data-start={e.start} data-eid={`${e.event}/${e.year}`} data-n={e.sessions.length}>
  <p class="date"><span class="d">{big}</span><span class="w">{small}</span></p>
  <div class="body">
    <H class="name"><a href={editionPath(e)}>{name}</a></H>
    <p class="where">{[e.city, e.venue].filter(Boolean).join(' · ')}</p>
    {e.tldr && <p class="tldr">{plain(e.tldr)}</p>}
  </div>
  <p class="tags">
    <span class="tag fav" data-lib="fav" hidden>★ favori</span>
    <span class="tag read" data-lib="read" hidden></span>
    {st === 'live' && <span class="tag live">en cours</span>}
    {!hideCategory && <span class={`tag cat-${category}`}>{CATEGORIES[category].short}</span>}
    {synth && <span class="tag done">{e.sessions.length} session{e.sessions.length > 1 ? 's' : ''} résumée{e.sessions.length > 1 ? 's' : ''}</span>}
    {e.status === 'pending' && st === 'past' && <span class="tag state">synthèse à venir</span>}
    {videos > 0 && <span class="tag video">▶ {videos} vidéo{videos > 1 ? 's' : ''}</span>}
    {conf && <span class="tag conf">{conf}</span>}
  </p>
</article>
<script>
  import { isMarked, isRead, readEntries, subscribe } from '../lib/library';

  // Reader's library: show bookmarked and read editions in every list.
  const rows = [...document.querySelectorAll<HTMLElement>('.row[data-eid]')];
  if (rows.length) subscribe(() => {
    const read = readEntries().map(([id]) => id);
    rows.forEach((r) => {
      const id = r.dataset.eid!;
      const n = Number(r.dataset.n);
      const k = Math.min(n, read.filter((x) => x.startsWith(`${id}#`)).length);
      const done = isRead(id) || (n > 0 && k === n);
      const fav = r.querySelector<HTMLElement>('[data-lib="fav"]')!;
      const tag = r.querySelector<HTMLElement>('[data-lib="read"]')!;
      fav.hidden = !isMarked(id);
      tag.hidden = !done && k === 0;
      tag.textContent = done ? '✓ lue' : `${k}/${n} lues`;
      r.classList.toggle('is-read', done);
    });
  });
</script>
<style>
  .row { position: relative; display: grid; grid-template-columns: var(--date-col) 1fr auto; gap: var(--space-1) var(--space-4); padding: var(--space-3-5) var(--space-2); border-bottom: 1px solid var(--line); align-items: start; border-radius: var(--radius-sm); }
  .row:hover { background: var(--surface); }
  .row.live { background: var(--hl); }
  p { margin: 0; }
  .date { font-family: var(--font-m); font-variant-numeric: tabular-nums; display: flex; flex-direction: column; }
  .d { font-weight: 600; font-size: var(--text-ui); }
  .w { font-size: var(--text-mono); color: var(--muted); }
  .body { display: flex; flex-direction: column; gap: var(--space-0-5); min-width: 0; }
  .name { font-family: var(--font-b); font-weight: 700; font-size: var(--text-body); line-height: 1.35; margin: 0; overflow-wrap: anywhere; }
  .name a { text-decoration: none; }
  /* The whole row is clickable, but only the name is the link (short accessible name). */
  .name a::after { content: ""; position: absolute; inset: 0; border-radius: var(--radius-sm); }
  .name a:focus-visible { outline: none; }
  .name a:focus-visible::after { outline: 2px solid var(--accent); outline-offset: -2px; }
  .row:hover .name a { text-decoration: underline; text-underline-offset: 3px; }
  .row.past:not(.synth) .name { color: var(--muted); font-weight: 600; }
  .where { color: var(--muted); font-size: var(--text-small); }
  .tldr { font-size: var(--text-small); margin-top: var(--space-1); max-width: var(--measure-prose); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-1-5); justify-content: flex-end; max-width: var(--tags-col); }
  @media (max-width: 640px) {
    .row { grid-template-columns: var(--date-col-sm) 1fr; }
    .tags { grid-column: 2; justify-content: flex-start; max-width: none; }
  }
</style>
