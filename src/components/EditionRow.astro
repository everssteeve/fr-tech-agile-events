---
import { CATEGORIES, CONFIDENCE, editionPath, type Edition, type Category, when } from '../lib/data';

interface Props {
  edition: Edition;
  name: string;
  category: Category;
}
const { edition: e, name, category } = Astro.props;
const st = when(e);
const WD = ['dim', 'lun', 'mar', 'mer', 'jeu', 'ven', 'sam'];
const MS = ['janv', 'févr', 'mars', 'avr', 'mai', 'juin', 'juil', 'août', 'sept', 'oct', 'nov', 'déc'];
const d = (s: string) => new Date(`${s}T12:00:00Z`);
let big = '—';
let small = 'date à venir';
if (e.start.length === 10) {
  const a = d(e.start);
  const b = d(e.end ?? e.start);
  const same = a.getUTCMonth() === b.getUTCMonth();
  big = e.end && e.end !== e.start ? (same ? `${a.getUTCDate()}–${b.getUTCDate()}` : `${a.getUTCDate()}–${b.getUTCDate()} ${MS[b.getUTCMonth()]}`) : String(a.getUTCDate());
  small = e.end && e.end !== e.start ? `${WD[a.getUTCDay()]}. → ${WD[b.getUTCDay()]}.` : `${WD[a.getUTCDay()]}.`;
}
const videos = e.sessions.filter((s) => s.video).length;
const conf = CONFIDENCE[e.dateConfidence];
---
<a class={`row ${st}`} href={editionPath(e)} data-cat={category} data-when={st === 'past' ? 'past' : 'upcoming'} data-synth={e.status === 'synthesized' ? '1' : '0'}>
  <span class="date"><span class="d">{big}</span><span class="w">{small}</span></span>
  <span class="body">
    <span class="name">{name}</span>
    <span class="where">{[e.city, e.venue].filter(Boolean).join(' · ')}</span>
    {e.tldr && <span class="tldr" set:html={e.tldr.replace(/\*\*(.+?)\*\*/g, '$1').replace(/\*(.+?)\*/g, '$1')} />}
  </span>
  <span class="tags">
    {st === 'live' && <span class="tag live">en cours</span>}
    <span class={`tag cat-${category}`}>{CATEGORIES[category].short}</span>
    {e.status === 'synthesized' && <span class="tag done">synthèse · {e.sessions.length} sessions</span>}
    {e.status === 'pending' && <span class="tag conf">synthèse en cours</span>}
    {videos > 0 && <span class="tag video">▶ {videos} vidéo{videos > 1 ? 's' : ''}</span>}
    {conf && <span class="tag conf">{conf}</span>}
  </span>
</a>
<style>
  .row { display: grid; grid-template-columns: 96px 1fr auto; gap: 4px 16px; padding: 14px 8px; border-bottom: 1px solid var(--line); text-decoration: none; color: inherit; align-items: start; border-radius: 6px; }
  .row:hover { background: var(--surface); }
  .row:hover .name { text-decoration: underline; text-underline-offset: 3px; }
  .row.past:not([data-synth="1"]) { opacity: .6; }
  .row.live { background: var(--hl); }
  .date { font-family: var(--font-m); font-variant-numeric: tabular-nums; display: flex; flex-direction: column; }
  .d { font-weight: 600; font-size: 15px; }
  .w { font-size: 11.5px; color: var(--muted); }
  .body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .name { font-weight: 700; font-size: 16.5px; overflow-wrap: anywhere; }
  .where { color: var(--muted); font-size: 13.5px; }
  .tldr { font-size: 14px; color: var(--ink); margin-top: 4px; max-width: 70ch; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .tags { display: flex; flex-wrap: wrap; gap: 5px; justify-content: flex-end; max-width: 240px; }
  @media (max-width: 640px) {
    .row { grid-template-columns: 72px 1fr; }
    .tags { grid-column: 2; justify-content: flex-start; max-width: none; }
  }
</style>
