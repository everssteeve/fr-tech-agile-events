---
import Base from '../../layouts/Base.astro';
import { CATEGORIES, eventPath, loadAll, type Category } from '../../lib/data';

const { events, editions } = await loadAll();
const groups = (Object.keys(CATEGORIES) as Category[]).map((cat) => ({
  cat,
  items: events
    .filter((e) => e.data.category === cat)
    .sort((a, b) => a.data.name.localeCompare(b.data.name, 'fr'))
    .map((e) => {
      const eds = editions.filter((x) => x.data.event === e.id);
      return { e, count: eds.length, synth: eds.filter((x) => x.data.status === 'synthesized').length };
    }),
}));
---
<Base title="Événements suivis" description="Toutes les séries d'événements tech et agiles suivies, avec leurs éditions.">
  <div class="wrap page">
    <header>
      <h1>Événements suivis</h1>
      <p class="lede">{events.length} conférences et rencontres, regroupées par thème. Chaque fiche liste les éditions et leurs synthèses.</p>
    </header>
    {groups.map((g) => (
      <section>
        <h2><span class="sw" style={`background:var(--${g.cat})`}></span>{CATEGORIES[g.cat].label} <small>{g.items.length}</small></h2>
        <ul class="grid">
          {g.items.map(({ e, count, synth }) => (
            <li>
              <a href={eventPath(e.id)}>
                <strong>{e.data.name}</strong>
                <span class="muted">{e.data.city}</span>
                <span class="small">{count} édition{count > 1 ? 's' : ''}{synth > 0 && ` · ${synth} synthèse${synth > 1 ? 's' : ''}`}{e.data.gaps.length > 0 && count === 0 && ' · pas d’édition récente'}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
<style>
  .page { display: flex; flex-direction: column; gap: 36px; }
  .lede { color: var(--muted); font-size: 17px; margin: 10px 0 0; }
  h2 { display: flex; align-items: center; gap: 10px; border-bottom: 2px solid var(--ink); padding-bottom: 6px; }
  h2 small { font-family: var(--font-m); font-size: 13px; color: var(--muted); font-weight: 400; }
  .sw { width: 12px; height: 12px; border-radius: 50%; }
  .grid { list-style: none; padding: 0; margin: 12px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 10px; }
  .grid a { display: flex; flex-direction: column; gap: 2px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); text-decoration: none; height: 100%; }
  .grid a:hover { border-color: var(--ink); }
  .small { font-family: var(--font-m); font-size: 12px; color: var(--muted); margin-top: 4px; }
</style>
