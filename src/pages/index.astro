---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import { addMonths, loadAll, monthKey, today, weekOf, yearPath } from '../lib/data';

const { editions, eventBySlug, monthByKey } = await loadAll();
const ref = today();
const currentMonth = ref.slice(0, 7);
const week = weekOf(ref);
const fmt = (s: string, withYear = false) =>
  new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', ...(withYear && { year: 'numeric' }), timeZone: 'UTC' }).format(new Date(`${s}T12:00:00Z`));

// The home shows the last 12 months and everything announced ahead; older years have their own pages.
const windowStart = addMonths(currentMonth, -11);
const visible = editions.filter((e) => {
  const m = monthKey(e.data);
  return m ? m >= windowStart : e.data.year >= Number(currentMonth.slice(0, 4));
});
const years = [...new Set(editions.map((e) => e.data.year))].sort((a, b) => b - a);
const earlier = years.filter((y) => y <= Number(windowStart.slice(0, 4)));
---
<Base title="Retours de conf' tech & agile" description="Calendrier et synthèses des retours participants des conférences tech et agiles en France.">
  <Timeline
    title="Calendrier"
    editions={visible}
    eventBySlug={eventBySlug}
    monthByKey={monthByKey}
    years={years}
    week={{ ...week, label: `${fmt(week.start)} – ${fmt(week.end, true)}` }}
    currentMonth={currentMonth}
  >
    <nav class="earlier" aria-label="Années précédentes" slot="before">
      <p>Plus tôt</p>
      <ul>{earlier.map((y) => <li><a class="chip" href={yearPath(y)}>{y}</a></li>)}</ul>
    </nav>
  </Timeline>
</Base>
<style is:global>
  .earlier { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding-block: 8px 4px; }
  .earlier p { margin: 0; font-family: var(--font-m); font-size: 12.5px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .earlier ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
</style>
