---
import Base from '../layouts/Base.astro';
import EditionRow from '../components/EditionRow.astro';
import {
  CATEGORIES, fixMonthLinks, loadAll, mdInline, monthKey, monthLabel, monthPath, today, weekOf,
  type EditionEntry,
} from '../lib/data';

const { editions, eventBySlug, monthByKey } = await loadAll();
const ref = today();
const week = weekOf(ref);
const endOf = (e: EditionEntry) => e.data.end ?? e.data.start;
const inWeek = (e: EditionEntry) => e.data.start.length === 10 && e.data.start <= week.end && endOf(e) >= week.start;
const currentMonth = ref.slice(0, 7);

// One continuous timeline: groups ordered chronologically. Year-only editions open their year.
type Group = { key: string; label: string; month: string | null; items: EditionEntry[] };
const groups = new Map<string, Group>();
const add = (key: string, label: string, month: string | null, e?: EditionEntry) => {
  if (!groups.has(key)) groups.set(key, { key, label, month, items: [] });
  if (e) groups.get(key)!.items.push(e);
};
for (const e of editions) {
  const m = monthKey(e.data);
  if (m) add(m, monthLabel(m), m, e);
  else add(`${e.data.year}-00`, `${e.data.year} · date non précisée`, null, e);
}
add(currentMonth, monthLabel(currentMonth), currentMonth);
const timeline = [...groups.values()].sort((a, b) => a.key.localeCompare(b.key));

const synthesized = editions.filter((e) => e.data.status === 'synthesized').length;
const fmt = (s: string) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', timeZone: 'UTC' }).format(new Date(`${s}T12:00:00Z`));
const weekLabel = `${fmt(week.start)} – ${fmt(week.end)}`;
---
<Base title="Retours de conf' tech & agile" description="Calendrier et synthèses des retours participants des conférences tech et agiles en France.">
  <div class="bar">
    <div class="wrap bar-in">
      <p class="summary">
        <strong>{editions.length}</strong> éditions · <strong>{synthesized}</strong> synthèse{synthesized > 1 ? 's' : ''} d'événement · <strong>{monthByKey.size}</strong> synthèse{monthByKey.size > 1 ? 's' : ''} mensuelle{monthByKey.size > 1 ? 's' : ''}
      </p>
      <div class="chips" role="group" aria-label="Thème">
        <button type="button" class="chip" data-f="cat" data-v="all" aria-pressed="true">Tous</button>
        {Object.entries(CATEGORIES).map(([k, c]) => (
          <button type="button" class="chip" data-f="cat" data-v={k} aria-pressed="false"><span class="sw" style={`background:var(--${k})`}></span>{c.short}</button>
        ))}
      </div>
      <div class="chips">
        <button type="button" class="chip" data-f="synth" data-v="1" aria-pressed="false">Avec synthèse</button>
        <a class="chip now" href="#cette-semaine" id="goto-week">↧ Cette semaine</a>
      </div>
    </div>
  </div>

  <div class="wrap timeline" id="timeline">
    <p class="edge muted">Début de l'historique. Descendez pour avancer dans le temps.</p>
    {timeline.map((g) => {
      const monthSynth = g.month ? monthByKey.get(g.month) : undefined;
      const isCurrent = g.month === currentMonth;
      const before = isCurrent ? g.items.filter((e) => !inWeek(e) && endOf(e) < week.start) : g.items;
      const during = isCurrent ? g.items.filter(inWeek) : [];
      const after = isCurrent ? g.items.filter((e) => !inWeek(e) && endOf(e) >= week.start) : [];
      return (
        <section class={`month${g.key < currentMonth ? ' is-past' : ''}`} id={g.month ?? `annee-${g.key.slice(0, 4)}`} data-month={g.key}>
          <header class="mh">
            <h2>{g.label}</h2>
            {monthSynth && <a class="msynth" href={monthPath(g.month!)}>Synthèse du mois →</a>}
          </header>
          {monthSynth && <p class="mtldr" set:html={fixMonthLinks(mdInline(monthSynth.data.tldr))} />}
          <div class="list">
            {before.map((e) => {
              const ev = eventBySlug.get(e.data.event);
              return ev && <EditionRow edition={e.data} name={ev.data.name} category={ev.data.category} />;
            })}
          </div>
          {isCurrent && (
            <div class="week" id="cette-semaine">
              <div class="week-h"><span class="dot" aria-hidden="true"></span>Cette semaine · {weekLabel}</div>
              <div class="list">
                {during.map((e) => {
                  const ev = eventBySlug.get(e.data.event);
                  return ev && <EditionRow edition={e.data} name={ev.data.name} category={ev.data.category} />;
                })}
              </div>
              <p class="week-empty muted" hidden={during.length > 0}>Aucun événement cette semaine. Remontez pour les événements passés, descendez pour les prochains.</p>
            </div>
          )}
          {after.length > 0 && (
            <div class="list">
              {after.map((e) => {
                const ev = eventBySlug.get(e.data.event);
                return ev && <EditionRow edition={e.data} name={ev.data.name} category={ev.data.category} />;
              })}
            </div>
          )}
        </section>
      );
    })}
    <p class="edge muted">Fin du calendrier connu. Les éditions suivantes apparaissent dès que leurs dates sont annoncées.</p>
  </div>
</Base>

<script>
  const state = { cat: 'all', synth: '' };
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.bar button.chip')];
  try {
    const saved = JSON.parse(localStorage.getItem('timeline-filters') ?? 'null');
    if (saved && typeof saved === 'object') Object.assign(state, { cat: saved.cat ?? 'all', synth: saved.synth ?? '' });
  } catch {}

  function apply() {
    chips.forEach((c) => {
      const k = c.dataset.f as 'cat' | 'synth';
      c.setAttribute('aria-pressed', String(k === 'synth' ? state.synth === '1' : state.cat === c.dataset.v));
    });
    document.querySelectorAll<HTMLElement>('.month').forEach((m) => {
      let n = 0;
      m.querySelectorAll<HTMLElement>('.row').forEach((r) => {
        const ok = (state.cat === 'all' || r.dataset.cat === state.cat) && (state.synth !== '1' || r.dataset.synth === '1');
        r.hidden = !ok;
        if (ok) n++;
      });
      const week = m.querySelector<HTMLElement>('.week');
      if (week) {
        const visible = [...week.querySelectorAll<HTMLElement>('.row')].some((r) => !r.hidden);
        week.querySelector<HTMLElement>('.week-empty')!.hidden = visible;
      }
      m.hidden = n === 0 && !week;
    });
  }
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      if (c.dataset.f === 'synth') state.synth = state.synth === '1' ? '' : '1';
      else state.cat = c.dataset.v!;
      try { localStorage.setItem('timeline-filters', JSON.stringify(state)); } catch {}
      apply();
    }),
  );
  apply();

  // Open on the current week: past above, upcoming below. A #YYYY-MM hash opens that month instead.
  // Fonts and images change row heights after first paint, so re-anchor until the layout settles,
  // unless the reader has started scrolling.
  const target = document.getElementById(decodeURIComponent(location.hash.slice(1))) ?? document.getElementById('cette-semaine');
  let userScrolled = false;
  const stop = () => { userScrolled = true; };
  ['wheel', 'touchmove', 'keydown', 'mousedown'].forEach((t) => addEventListener(t, stop, { once: true, passive: true }));
  const anchor = () => { if (!userScrolled) target?.scrollIntoView({ block: 'start' }); };
  anchor();
  document.fonts?.ready.then(anchor);
  addEventListener('load', anchor);
  setTimeout(anchor, 800);
</script>

<style>
  .bar { position: sticky; top: 58px; z-index: 8; background: var(--bg); border-bottom: 1px solid var(--line); }
  @media (max-width: 640px) {
    .bar { top: 0; }
    .bar-in { flex-wrap: nowrap; overflow-x: auto; gap: 6px; scrollbar-width: none; }
    .bar-in .chips { flex-wrap: nowrap; }
    .summary { display: none; }
    .chip { white-space: nowrap; }
  }
  .bar-in { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; padding-block: 10px; }
  .summary { margin: 0; font-size: 13.5px; color: var(--muted); flex: 1 1 100%; }
  .summary strong { color: var(--ink); font-variant-numeric: tabular-nums; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip.now { border-color: var(--accent); color: var(--accent); }
  .timeline { display: flex; flex-direction: column; gap: 30px; padding-block: 24px 40vh; }
  .edge { text-align: center; font-size: 13px; margin: 0; }
  .month { scroll-margin-top: 150px; display: flex; flex-direction: column; gap: 4px; }
  .mh { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; border-bottom: 2px solid var(--ink); padding-bottom: 6px; }
  .mh h2 { font-size: 22px; text-transform: capitalize; }
  .month.is-past .mh { border-bottom-color: var(--line); }
  .month.is-past .mh h2 { color: var(--muted); }
  .msynth { font-size: 14px; font-weight: 700; color: var(--accent); text-decoration: none; }
  .msynth:hover { text-decoration: underline; }
  .mtldr { margin: 6px 0 4px; font-size: 14.5px; color: var(--muted); max-width: 80ch; }
  .list { display: flex; flex-direction: column; }
  .week { scroll-margin-top: 150px; margin-block: 10px; border: 2px solid var(--accent); border-radius: 10px; padding: 8px 10px 4px; background: var(--surface); }
  .week-h { font-family: var(--font-m); font-size: 12.5px; text-transform: uppercase; letter-spacing: .06em; color: var(--accent); display: flex; align-items: center; gap: 8px; padding: 4px 4px 6px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .week-empty { margin: 4px 4px 8px; font-size: 14px; }
</style>
