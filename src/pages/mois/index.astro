---
import Base from '../../layouts/Base.astro';
import { loadAll, mdInline, monthLabel, monthPath } from '../../lib/data';

const { months } = await loadAll();
const sorted = [...months].sort((a, b) => b.data.month.localeCompare(a.data.month));
---
<Base title="Synthèses mensuelles" description="Chaque mois, ce qui traverse les conférences tech et agiles françaises.">
  <div class="wrap page">
    <header>
      <h1>Synthèses mensuelles</h1>
      <p class="lede">Chaque mois, une synthèse des synthèses : ce qui revient d'une conférence à l'autre, entre agilité, produit, dev et IA. Un mois apparaît dès qu'une de ses conférences est synthétisée.</p>
    </header>
    <ol class="months">
      {sorted.map((m) => (
        <li>
          <h2 class="m"><a href={monthPath(m.data.month)}>{monthLabel(m.data.month)}</a></h2>
          <p class="n">{m.data.editions.length} événement{m.data.editions.length > 1 ? 's' : ''}</p>
          <p class="t" set:html={mdInline(m.data.tldr)} />
        </li>
      ))}
    </ol>
    {sorted.length === 0 && <p class="muted">Aucune synthèse mensuelle pour l'instant.</p>}
  </div>
</Base>
<style>
  .page { display: flex; flex-direction: column; gap: var(--space-7); }
  .lede { color: var(--muted); font-size: var(--text-lede); margin: var(--space-2-5) 0 0; max-width: 64ch; }
  .months { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; }
  .months li { position: relative; display: grid; grid-template-columns: 180px 1fr; gap: var(--space-0-5) var(--space-5); padding: var(--space-4) var(--space-2); border-bottom: 1px solid var(--line); border-radius: var(--radius-sm); }
  .months li:hover { background: var(--surface); }
  .months p { margin: 0; }
  .m { font-size: var(--text-heading); text-transform: capitalize; }
  .m a { text-decoration: none; }
  .m a::after { content: ""; position: absolute; inset: 0; }
  .months li:hover .m a { text-decoration: underline; text-underline-offset: 3px; }
  .n { font-family: var(--font-m); font-size: var(--text-mono); color: var(--muted); grid-column: 1; }
  .t { grid-column: 2; grid-row: 1 / span 2; max-width: var(--measure-prose); }
  @media (max-width: 640px) { .months li { grid-template-columns: 1fr; } .t { grid-column: 1; grid-row: auto; } }
</style>
