---
import Base from '../../layouts/Base.astro';
import EditionRow from '../../components/EditionRow.astro';
import { fixMonthLinks, formatDay, loadAll, mdInline, mdWithToc, monthKey, monthLabel, monthPath } from '../../lib/data';
import type { MonthEntry } from '../../lib/data';

export async function getStaticPaths() {
  const { months } = await loadAll();
  const keys = months.map((m) => m.data.month).sort();
  return months.map((m) => {
    const i = keys.indexOf(m.data.month);
    return { params: { month: m.data.month }, props: { entry: m, prev: keys[i - 1], next: keys[i + 1] } };
  });
}
interface Props {
  entry: MonthEntry;
  prev?: string;
  next?: string;
}
const { entry, prev, next } = Astro.props;
const m = entry.data;
const { editions, eventBySlug } = await loadAll();
const list = editions.filter((e) => monthKey(e.data) === m.month);
const { html: rawBody, headings } = mdWithToc(entry.body ?? '');
const body = fixMonthLinks(rawBody);
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const title = monthLabel(m.month);
---
<Base title={`${title[0]!.toUpperCase()}${title.slice(1)} · synthèse du mois`} description={m.tldr.replace(/\*/g, '')}>
  <article class="wrap page">
    <header class="head">
      <nav class="pager" aria-label="Mois">
        {prev ? <a href={monthPath(prev)}>← {cap(monthLabel(prev))}</a> : <span></span>}
        <a href={`${import.meta.env.BASE_URL}#${m.month}`}>Voir dans le calendrier</a>
        {next ? <a href={monthPath(next)}>{cap(monthLabel(next))} →</a> : <span></span>}
      </nav>
      <div class="eyebrow">Synthèse du mois · {m.editions.length} événement{m.editions.length > 1 ? 's' : ''} synthétisé{m.editions.length > 1 ? 's' : ''}</div>
      <h1 class="cap">{title}</h1>
      <p class="lead" set:html={mdInline(m.tldr)} />
      <p class="muted small">Synthèse des synthèses d'événements du mois · mise à jour le {formatDay(m.updatedAt)} {m.updatedAt.slice(0, 4)}</p>
      {headings.length > 0 && (
        <nav class="themes" aria-label="Thèmes du mois">
          {headings.map((h) => <a class="chip" href={`#${h.id}`} set:html={h.text} />)}
        </nav>
      )}
    </header>
    <section aria-labelledby="h-body">
      <h2 id="h-body" class="sr-only">Synthèse du mois</h2>
      <div class="prose" set:html={body} />
    </section>
    <section>
      <h2>Tous les événements du mois</h2>
      <div class="list">
        {list.map((e) => {
          const ev = eventBySlug.get(e.data.event);
          return ev && <EditionRow edition={e.data} name={ev.data.name} category={ev.data.category} />;
        })}
      </div>
    </section>
  </article>
</Base>
<style>
  .page { display: flex; flex-direction: column; gap: 32px; }
  .head { display: flex; flex-direction: column; gap: 12px; }
  .pager { display: flex; justify-content: space-between; gap: 12px; font-size: 14px; flex-wrap: wrap; }
  .pager a { color: var(--muted); padding-block: 8px; text-underline-offset: 3px; }
  .cap { text-transform: capitalize; }
  .themes { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 0; }
  .lead { font-family: var(--font-d); font-weight: 500; font-size: clamp(19px, 2.2vw, 22px); line-height: 1.45; }
  .small { font-size: 13.5px; margin: 0; }
  h2 { border-bottom: 2px solid var(--ink); padding-bottom: 6px; margin-bottom: 4px; }
  .list { display: flex; flex-direction: column; }
</style>
